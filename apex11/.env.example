# Copy to .env and fill in what you need. Every one of these is optional:
# with none of them APEX runs in paper mode on the synthetic feed.

# --- core -------------------------------------------------------------------
# APEX_CONFIG=config/default.yaml
# APEX_DATA_DIR=/var/data
# APEX_ROLES=web,collector,trader          # container only

# --- API --------------------------------------------------------------------
# Required to use /api/control/{pause,resume,reset_risk,flatten} from a
# non-loopback client. Without it, control fails closed on a public host.
# APEX_API_TOKEN=change-me-long-random

# --- Deriv (demo only — the client refuses is_virtual == 0) -----------------
# DERIV_API_TOKEN=your-demo-account-token
# DERIV_APP_ID=1089

# --- secrets manager (container) --------------------------------------------
# APEX_SECRETS=doppler                     # env | file | doppler | infisical
# DOPPLER_TOKEN=dp.st.prd.xxxx
# DOPPLER_PROJECT=apex
# DOPPLER_CONFIG=prd

# --- optional LLM advisor ---------------------------------------------------
# APEX_LLM_API_KEY=sk-...
