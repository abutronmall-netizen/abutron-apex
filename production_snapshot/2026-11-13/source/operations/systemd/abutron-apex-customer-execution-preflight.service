[Unit]
Description=ABUTRONFX APEX per-client order preflight (read-only, never executes)
After=abutron-client-shadow-fanout.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -B /opt/apex-client-mt5/customer_execution_preflight.py
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/apex-client-feed
RestrictAddressFamilies=AF_UNIX
MemoryMax=150M
TasksMax=35
UMask=0077
TimeoutStartSec=20
