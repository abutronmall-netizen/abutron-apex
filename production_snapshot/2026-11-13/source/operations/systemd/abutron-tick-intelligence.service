[Unit]
Description=ABUTRON Deriv DEMO native tick and broker execution-cost research ONLY (no orders)
After=local-fs.target
ConditionPathExists=/opt/abutron-research/tick-intelligence/abutron_tick_intelligence_v1.py

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -B /opt/abutron-research/tick-intelligence/abutron_tick_intelligence_v1.py
TimeoutStartSec=85
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateNetwork=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
CPUQuota=35%
MemoryMax=256M
TasksMax=20
ReadWritePaths=/var/lib/abutron-quant-first/tick-intelligence
