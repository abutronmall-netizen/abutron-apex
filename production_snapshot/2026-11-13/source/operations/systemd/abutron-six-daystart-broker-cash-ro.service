[Unit]
Description=ABUTRON six-account broker-native UTC daystart cash and funding reconstruction (READ ONLY)
After=local-fs.target
[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -B /usr/local/sbin/abutron-six-daystart-broker-cash-ro
ProtectSystem=strict
ReadWritePaths=/var/lib/abutron-v4-broker-crm-supervisor-6207
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
UMask=0077
MemoryMax=120M
TasksMax=12
RestrictAddressFamilies=AF_UNIX
