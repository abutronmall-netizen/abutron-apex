[Unit]
Description=ABUTRONFX APEX read-only production cutover evidence monitor
After=abutron-client-shadow-fanout.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -B /opt/apex-client-mt5/handover_readiness.py
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/apex-client-feed
RestrictAddressFamilies=AF_UNIX
UMask=0077
MemoryMax=150M
TasksMax=40
TimeoutStartSec=25
