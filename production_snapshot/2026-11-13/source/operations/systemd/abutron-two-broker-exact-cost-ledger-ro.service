[Unit]
Description=ABUTRON 6207 FP0512 broker-native exact-order readiness, quotes and commission audit (READ ONLY)
After=local-fs.target
[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -B /usr/local/sbin/abutron-two-broker-exact-cost-ledger-ro
ProtectSystem=strict
ReadWritePaths=/var/lib/abutron-v4-broker-crm-supervisor-6207
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
UMask=0077
MemoryMax=150M
TasksMax=12
RestrictAddressFamilies=AF_UNIX
