[Unit]
Description=Abutron V7 owner-only Kronos DEMO signal notifications (portal and optional Telegram)
After=postgresql.service abutron-v7-api.service network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=abutron_v7_release_app
Group=abutron_v7_release_app
WorkingDirectory=/opt/abutron/v7/backend
EnvironmentFile=/etc/abutron/v7-api.env
EnvironmentFile=/etc/abutron/v7-email.env
EnvironmentFile=/etc/abutron/v7-privacy-optout.env
EnvironmentFile=-/etc/abutron/v7-telegram-signals.env
ExecStart=/opt/abutron/v7/venv/bin/python3 -B /usr/local/libexec/abutron/abutron_v7_signal_delivery.py
TimeoutStartSec=35
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/abutron-v7-signal-delivery
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
UMask=0077
