[Unit]
Description=ABUTRON FP Markets independent second-owner native UI publisher (DEMO/read-only)
After=abutron-fpmarkets-native-feed.service abutron-fp-partial-research.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/apex-client-mt5/fpmarkets-research-partial
ExecStart=/usr/bin/python3 -B /opt/apex-client-mt5/fpmarkets-research-partial/fp_multi_account_native_publisher.py
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ReadWritePaths=/var/lib/apex/operator-live /var/lib/apex-signup/fp-market-ui
MemoryMax=300M
TasksMax=20
CPUQuota=70%
UMask=0077
TimeoutStartSec=30
