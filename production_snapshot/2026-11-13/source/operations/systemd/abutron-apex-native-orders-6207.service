[Unit]
Description=ABUTRON APEX native qualified Deriv DEMO 6207 only (CRM OFF respected)
After=abutron-client-native-feed.service abutron-client-shadow-fanout.service
Wants=abutron-client-native-feed.timer

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -B /opt/apex-client-mt5/apex_native_order_runtime.py --dispatch --only-demo-connection d6fc2524ec373b8d1bc278a8be3ec635
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/apex-client-feed /var/lib/private
RestrictAddressFamilies=AF_UNIX
UMask=0077
TasksMax=40
MemoryMax=256M
TimeoutStartSec=35
