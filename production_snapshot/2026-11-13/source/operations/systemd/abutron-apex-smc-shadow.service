[Unit]
Description=ABUTRON APEX SMC/ICT account-isolated non-executing shadow research
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/apex-smc-shadow-v1
ExecStart=/usr/bin/python3 -B /opt/apex-smc-shadow-v1/monitor.py
TimeoutStartSec=30s
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/apex-smc-shadow
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
MemoryMax=320M
TasksMax=24
