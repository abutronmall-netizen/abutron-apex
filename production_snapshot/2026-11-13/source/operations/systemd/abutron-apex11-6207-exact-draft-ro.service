[Unit]
Description=ABUTRON APEX11 Deriv 6207 broker-derived exact order DRAFT (READ ONLY, NO ORDERS)
After=abutron-apex11-6207-account-publisher-ro.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -B /usr/local/sbin/abutron-apex11-6207-exact-draft-ro
UMask=0077
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
ReadWritePaths=/var/lib/abutron-apex11-6207
TimeoutStartSec=25
MemoryMax=180M
CPUQuota=100%
TasksMax=25
