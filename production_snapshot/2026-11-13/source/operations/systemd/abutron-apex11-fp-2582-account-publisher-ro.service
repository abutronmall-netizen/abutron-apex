[Unit]
Description=ABUTRON APEX 1.1 FP Markets 2582 account-bound M5 journal (READ ONLY)
After=abutron-client-mt5-manager.service abutron-fpmarkets-native-feed.service
Wants=abutron-fpmarkets-native-feed.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/abutron-apex11-staging/native-v4-guarded-20261108/qa-venv/bin/python -B /usr/local/sbin/abutron-apex11-fp-account-publisher-ro 2582
Environment=APEX_DATA_DIR=/var/lib/abutron-apex11-fp-2582
WorkingDirectory=/var/lib/abutron-apex11-fp-2582
UMask=0077
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
ReadWritePaths=/var/lib/abutron-apex11-fp-2582 /var/lib/apex/operator-live
TimeoutStartSec=50
MemoryMax=650M
TasksMax=50
