[Unit]
Description=ABUTRON Deriv 6207 native V4 owner/MT5/risk preflight (read-only; NEVER orders)
After=postgresql.service abutron-client-mt5-manager.service
[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -B /usr/local/sbin/abutron-v4-native-preflight-6207
NoNewPrivileges=no
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_DAC_READ_SEARCH
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
UMask=0077
MemoryMax=160M
TasksMax=24
TimeoutStartSec=25
