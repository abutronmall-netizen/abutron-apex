[Unit]
Description=ABUTRON 6207 DEMO: disable new entries permanently at 16:00 SAST

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 -B /opt/apex-client-mt5/quant-first/abutron_6207_multi_stop_v1.py
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/abutron-6207-pilot /etc/systemd/system /run/systemd/system /run/systemd/transient
TimeoutStartSec=40
