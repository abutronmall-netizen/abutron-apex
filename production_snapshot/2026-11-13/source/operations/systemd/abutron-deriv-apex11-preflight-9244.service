[Unit]
Description=ABUTRON Deriv DEMO 9244 account-bound broker costs and APEX exact draft (NO SEND)
After=local-fs.target abutron-apex11-9244-account-publisher-ro.service
ConditionPathExists=/opt/apex-client-mt5/deriv-execution/deriv_v4_exact_draft_9244.py

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStartPre=/usr/bin/python3 -B /opt/apex-client-mt5/deriv-execution/deriv_v4_native_cost_9244.py
ExecStart=/usr/bin/python3 -B /opt/apex-client-mt5/deriv-execution/deriv_v4_exact_draft_9244.py
ExecStartPost=/usr/bin/python3 -B /opt/apex-client-mt5/deriv-execution/deriv_v4_apex_writer.py --account 9244
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ReadWritePaths=/var/lib/abutron-apex11-9244 /var/lib/abutron-deriv-v4-9244 /var/lib/apex-signup /var/lib/private/abutron-client-mt5-1ead1f08b44dc5ae284eadc9554b1381/terminal/MQL5/Files/ABUTRON
MemoryMax=225M
TasksMax=16
TimeoutStartSec=25
