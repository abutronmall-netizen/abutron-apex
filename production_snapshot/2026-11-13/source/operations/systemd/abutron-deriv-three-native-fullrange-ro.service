[Unit]
Description=ABUTRON three Deriv DEMO full-range native funding and trade reconciliation (NO ORDERS)
After=local-fs.target
[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -B /usr/local/sbin/abutron-deriv-three-native-fullrange-ro
ProtectSystem=strict
ReadWritePaths=/var/lib/abutron-v4-broker-crm-supervisor-6207
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
UMask=0077
MemoryMax=140M
TasksMax=12
RestrictAddressFamilies=AF_UNIX
