[Unit]
Description=ABUTRON Option C DEMO adaptive risk shadow — research only, no orders
After=local-fs.target
ConditionPathExists=/var/backups/abutron-option-c-readonly-audit-20261105/optionc_shadow.py

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/var/backups/abutron-option-c-readonly-audit-20261105
ExecStart=/usr/bin/python3 -B /var/backups/abutron-option-c-readonly-audit-20261105/optionc_watch.py
TimeoutStartSec=30s
Nice=15
IOSchedulingClass=idle
CPUQuota=10%
MemoryMax=192M
TasksMax=16
UMask=0077
NoNewPrivileges=true
PrivateNetwork=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
