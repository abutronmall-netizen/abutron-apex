[Unit]
Description=ABUTRON precommitted entry-model forward market outcome capture (SHADOW NO ORDERS)
After=local-fs.target
ConditionPathExists=/opt/apex-client-mt5/quant-first/abutron_entry_forward_v1.py
ConditionPathExists=/var/lib/apex/operator-live/native-market.json

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -B /opt/apex-client-mt5/quant-first/abutron_entry_forward_v1.py
TimeoutStartSec=22
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/abutron-quant-first
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
MemoryMax=256M
CPUQuota=20%
