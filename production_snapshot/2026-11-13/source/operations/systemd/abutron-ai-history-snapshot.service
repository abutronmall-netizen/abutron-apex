[Unit]
Description=ABUTRON read-only broker candle history snapshot for AI Decisions
After=abutron-precision-history.service

[Service]
Type=oneshot
User=apexagent
Group=apexagent
ExecStart=/usr/bin/python3 -B /opt/apex/runtime/abutron_ai_history_snapshot.py
TimeoutStartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/apex/precision-history /var/lib/apex/precision-history-ai-snapshot
ProtectHome=true
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectControlGroups=true
