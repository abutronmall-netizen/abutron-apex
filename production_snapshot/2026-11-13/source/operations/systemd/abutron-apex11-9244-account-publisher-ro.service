[Unit]
Description=ABUTRON APEX11 Deriv DEMO 9244 account-bound M5 publisher (READ ONLY)
After=abutron-client-mt5-1ead1f08b44dc5ae284eadc9554b1381.service
Wants=abutron-client-mt5-1ead1f08b44dc5ae284eadc9554b1381.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/abutron-apex11-staging/native-v4-guarded-20261108/qa-venv/bin/python -B /usr/local/sbin/abutron-apex11-9244-account-publisher-ro
