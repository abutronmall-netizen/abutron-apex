[Unit]
Description=ABUTRON 6207-only protected broker reconciliation (NO NEW ORDERS)
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 -B /opt/apex-client-mt5/quant-first/abutron_6207_one_shot_pilot_v1.py --reconcile
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/apex-client-feed
MemoryMax=256M
TimeoutStartSec=25
