[Unit]
Description=ABUTRON Deriv 6207 independent READ-ONLY V4 chart attachment audit (NO ORDERS)
After=postgresql.service abutron-client-mt5-d6fc2524ec373b8d1bc278a8be3ec635.service abutron-native-readonly-mt5-6207.service
Wants=postgresql.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -B /usr/local/sbin/abutron-v4-readonly-chart-attest-6207
NoNewPrivileges=no
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_DAC_READ_SEARCH
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/abutron-v4-broker-crm-supervisor-6207
TasksMax=24
MemoryMax=160M
TimeoutStartSec=25
